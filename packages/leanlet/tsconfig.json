{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true
  },
  "include": ["src/index.ts", "src/models.ts", "src/types.ts", "src/scoped-leanlet.ts", "src/vision-leanlet.ts"],
  "exclude": ["src/vision.worker.ts"]
}
