{
  "name": "leanlet-ai",
  "version": "0.2.0",
  "description": "Run scoped, task-specific inference inside web applications.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "sukumar09",
  "homepage": "https://sukumarrekapalli.github.io/leanlet/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sukumarrekapalli/leanlet.git",
    "directory": "packages/leanlet"
  },
  "bugs": {
    "url": "https://github.com/sukumarrekapalli/leanlet/issues"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "bin",
    "README.md",
    "MODEL_LICENSES.md",
    "LICENSE"
  ],
  "bin": {
    "leanlet": "bin/leanlet.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "browser-ai",
    "on-device-ai",
    "webassembly",
    "onnx",
    "local-inference",
    "machine-learning"
  ],
  "dependencies": {
    "@huggingface/transformers": "^3.8.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
